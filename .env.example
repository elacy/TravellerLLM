# Server
PORT=3080
RUST_LOG=info,traveller_server=debug,traveller_llm=debug
FRONTEND_DIR=./frontend/dist
DATA_PACKS_DIR=./packs

# PostgreSQL (NAS or local)
DATABASE_URL=postgres://traveller:traveller@localhost:5432/traveller

# LiteLLM Proxy (NAS)
LITELLM_BASE_URL=http://nas.lacy.ie:4000
LITELLM_API_KEY=sk-your-litellm-key

# Models (Tiered for cost)
REFEREE_MODEL=anthropic/claude-sonnet-4-5
WORKER_MODEL=deepseek/deepseek-v4.1-flash-1017
SUMMARIZER_FALLBACK_MODEL=z-ai/glm-5.3-flash

# Hindsight Memory Server (NAS)
HINDSIGHT_BASE_URL=http://nas.lacy.ie:8888
HINDSIGHT_API_KEY=
HINDSIGHT_ENABLED=true
