# Server
PORT=3080
RUST_LOG=info,traveller_server=debug,traveller_llm=debug
FRONTEND_DIR=./frontend/dist
DATA_PACKS_DIR=./packs

# Authentication (Authentik via Traefik ForwardAuth on NAS, or OIDC, or none for local dev)
AUTH_MODE=authentik_proxy
# Optional allowlists (comma-separated)
AUTH_ALLOWED_USERS=
AUTH_ALLOWED_GROUPS=
AUTH_LOGIN_URL=https://auth.i.lacy.ie
AUTH_LOGOUT_URL=/outpost.goauthentik.io/sign_out

# Optional standalone OIDC mode (set AUTH_MODE=oidc)
# OIDC_ISSUER=https://auth.i.lacy.ie/application/o/travellerllm/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://traveller.i.lacy.ie/api/auth/callback
# SESSION_SECRET=change-me-to-a-long-random-string

# PostgreSQL (NAS or local)
DATABASE_URL=postgres://traveller:traveller@localhost:5432/traveller

# LiteLLM Proxy (NAS)
LITELLM_BASE_URL=http://nas.lacy.ie:4000
LITELLM_API_KEY=sk-your-litellm-key

# Models (Tiered for cost — Claude uses /anthropic/v1/messages with 1h cache; DeepSeek/others use /v1/chat/completions)
REFEREE_MODEL=anthropic/claude-sonnet-4-5
WORKER_MODEL=deepseek/deepseek-v4.1-flash-1017
SUMMARIZER_FALLBACK_MODEL=z-ai/glm-5.3-flash

# Hindsight Memory Server (NAS)
HINDSIGHT_BASE_URL=http://nas.lacy.ie:8888
HINDSIGHT_API_KEY=
HINDSIGHT_ENABLED=true
